# Sandbox Service Environment Configuration
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sandbox
REDIS_URL=redis://default:<password>@<redis-host>:<port>
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# Base domain used for constructing sandbox preview URLs
# Local k8s dev: preview.localtest.me
# Direct host port fallback: localhost:3000
PREVIEW_DOMAIN=preview.localtest.me
